generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                                          String                   @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  name                                        String                   @db.VarChar(100)
  email                                       String                   @unique(map: "uk_users_email") @db.VarChar(255)
  password                                    String                   @db.VarChar(255)
  email_verified_at                           DateTime?                @db.DateTime(0)
  is_active                                   Boolean                  @default(true)
  created_at                                  DateTime                 @default(now()) @db.DateTime(0)
  updated_at                                  DateTime                 @updatedAt @db.DateTime(0)
  accounts                                    accounts[]
  audit_logs                                  audit_logs[]
  budgets                                     budgets[]
  categories                                  categories[]
  event_members                               event_members[]
  events                                      events[]
  expense_item_members                        expense_item_members[]
  expense_members                             expense_members[]
  expense_payments                            expense_payments[]
  expenses                                    expenses[]
  group_members                               group_members[]
  groups                                      groups[]
  invitations_invitations_invitee_idTousers   invitations[]            @relation("invitations_invitee_idTousers")
  invitations_invitations_inviter_idTousers   invitations[]            @relation("invitations_inviter_idTousers")
  notifications                               notifications[]
  payment_methods                             payment_methods[]
  profiles                                    Profile?
  recurring_transactions                      recurring_transactions[]
  refresh_tokens                              RefreshToken[]
  savings_goals                               savings_goals[]
  settlements_settlements_from_user_idTousers settlements[]            @relation("settlements_from_user_idTousers")
  settlements_settlements_to_user_idTousers   settlements[]            @relation("settlements_to_user_idTousers")
  transactions                                transactions[]
  transfers                                   transfers[]

  @@index([is_active], map: "idx_users_active")
  @@map("users")
}

model Profile {
  user_id    String   @id @db.VarChar(36)
  username   String?  @unique(map: "uk_profiles_username") @db.VarChar(50)
  full_name  String?  @db.VarChar(255)
  avatar_url String?  @db.Text
  phone      String?  @db.VarChar(50)
  bio        String?  @db.Text
  currency   String   @default("IDR") @db.Char(3)
  timezone   String   @default("Asia/Jakarta") @db.VarChar(50)
  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @updatedAt @db.DateTime(0)
  users      User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_profiles_user")

  @@index([user_id], map: "idx_profiles_user_id")
  @@map("profiles")
}

model RefreshToken {
  id                   String         @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  user_id              String         @db.VarChar(36)
  token_hash           String         @unique(map: "uk_refresh_tokens_hash") @db.VarChar(255)
  expires_at           DateTime       @db.DateTime(0)
  revoked_at           DateTime?      @db.DateTime(0)
  replaced_by_token_id String?        @db.VarChar(36)
  created_at           DateTime       @default(now()) @db.DateTime(0)
  refresh_tokens       RefreshToken?  @relation("refresh_tokensTorefresh_tokens", fields: [replaced_by_token_id], references: [id], onUpdate: NoAction, map: "fk_refresh_tokens_replaced_by")
  other_refresh_tokens RefreshToken[] @relation("refresh_tokensTorefresh_tokens")
  users                User           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_refresh_tokens_user")

  @@index([user_id], map: "idx_refresh_tokens_user_id")
  @@index([expires_at], map: "idx_refresh_tokens_expires_at")
  @@index([replaced_by_token_id], map: "fk_refresh_tokens_replaced_by")
  @@map("refresh_tokens")
}

model accounts {
  id                                            String                   @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  user_id                                       String                   @db.VarChar(36)
  name                                          String                   @db.VarChar(255)
  type                                          accounts_type
  institution_name                              String?                  @db.VarChar(255)
  account_number_masked                         String?                  @db.VarChar(255)
  initial_balance                               Decimal                  @default(0.00) @db.Decimal(18, 2)
  currency                                      String                   @default("IDR") @db.Char(3)
  is_active                                     Boolean                  @default(true)
  include_in_total_balance                      Boolean                  @default(true)
  created_at                                    DateTime                 @default(now()) @db.DateTime(0)
  updated_at                                    DateTime                 @updatedAt @db.DateTime(0)
  users                                         User                     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_accounts_user")
  expense_payments                              expense_payments[]
  payment_methods                               payment_methods[]
  recurring_transactions                        recurring_transactions[]
  savings_contributions                         savings_contributions[]
  settlements                                   settlements[]
  transactions                                  transactions[]
  transfers_transfers_from_account_idToaccounts transfers[]              @relation("transfers_from_account_idToaccounts")
  transfers_transfers_to_account_idToaccounts   transfers[]              @relation("transfers_to_account_idToaccounts")

  @@index([user_id, is_active], map: "idx_accounts_active")
  @@index([user_id], map: "idx_accounts_user_id")
}

model categories {
  id                     String                   @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  user_id                String?                  @db.VarChar(36)
  parent_id              String?                  @db.VarChar(36)
  name                   String                   @db.VarChar(100)
  type                   categories_type
  icon                   String?                  @db.VarChar(100)
  color                  String?                  @db.VarChar(50)
  is_system              Boolean                  @default(false)
  created_at             DateTime                 @default(now()) @db.DateTime(0)
  updated_at             DateTime                 @updatedAt @db.DateTime(0)
  budget_categories      budget_categories[]
  categories             categories?              @relation("categoriesTocategories", fields: [parent_id], references: [id], onUpdate: NoAction, map: "fk_categories_parent")
  other_categories       categories[]             @relation("categoriesTocategories")
  users                  User?                    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_categories_user")
  recurring_transactions recurring_transactions[]
  transactions           transactions[]

  @@index([parent_id], map: "idx_categories_parent_id")
  @@index([type], map: "idx_categories_type")
  @@index([user_id], map: "idx_categories_user_id")
}

model groups {
  id            String          @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  owner_id      String          @db.VarChar(36)
  name          String          @db.VarChar(150)
  description   String?         @db.Text
  type          groups_type     @default(other)
  avatar_url    String?         @db.Text
  currency      String          @default("IDR") @db.Char(3)
  invite_code   String          @unique(map: "invite_code") @db.VarChar(50)
  is_archived   Boolean         @default(false)
  created_at    DateTime        @default(now()) @db.DateTime(0)
  updated_at    DateTime        @updatedAt @db.DateTime(0)
  events        events[]
  expenses      expenses[]
  group_members group_members[]
  users         User            @relation(fields: [owner_id], references: [id], onUpdate: NoAction, map: "fk_groups_owner")
  invitations   invitations[]
  settlements   settlements[]

  @@index([owner_id], map: "idx_groups_owner_id")
}

model event_members {
  id        String   @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  event_id  String   @db.VarChar(36)
  user_id   String   @db.VarChar(36)
  joined_at DateTime @default(now()) @db.DateTime(0)
  events    events   @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_event_members_event")
  users     User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_event_members_user")

  @@unique([event_id, user_id], map: "uk_event_user")
  @@index([event_id], map: "idx_event_members_event_id")
  @@index([user_id], map: "idx_event_members_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model events {
  id            String          @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  group_id      String          @db.VarChar(36)
  created_by    String          @db.VarChar(36)
  name          String          @db.VarChar(255)
  description   String?         @db.Text
  location      String?         @db.VarChar(255)
  start_date    DateTime?       @db.DateTime(0)
  end_date      DateTime?       @db.DateTime(0)
  status        events_status   @default(planning)
  budget        Decimal?        @db.Decimal(18, 2)
  created_at    DateTime        @default(now()) @db.DateTime(0)
  updated_at    DateTime        @updatedAt @db.DateTime(0)
  event_members event_members[]
  users         User            @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_events_created_by")
  groups        groups          @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_events_group")
  expenses      expenses[]

  @@index([created_by], map: "idx_events_created_by")
  @@index([group_id], map: "idx_events_group_id")
  @@index([start_date], map: "idx_events_start_date")
}

