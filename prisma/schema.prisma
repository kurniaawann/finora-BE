}

model recurring_transactions {
  id            String                           @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  user_id       String                           @db.VarChar(36)
  account_id    String?                          @db.VarChar(36)
  category_id   String?                          @db.VarChar(36)
  type          recurring_transactions_type
  name          String                           @db.VarChar(255)
  amount        Decimal                          @db.Decimal(18, 2)
  frequency     recurring_transactions_frequency
  start_date    DateTime                         @db.Date
  end_date      DateTime?                        @db.Date
  next_run_date DateTime                         @db.Date
  is_active     Boolean                          @default(true)
  description   String?                          @db.Text
  created_at    DateTime                         @default(now()) @db.DateTime(0)
  updated_at    DateTime                         @updatedAt @db.DateTime(0)
  accounts      accounts?                        @relation(fields: [account_id], references: [id], onUpdate: NoAction, map: "fk_recurring_account")
  categories    categories?                      @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "fk_recurring_category")
  users         User                             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_recurring_user")

  @@index([account_id], map: "fk_recurring_account")
  @@index([category_id], map: "fk_recurring_category")
  @@index([next_run_date, is_active], map: "idx_recurring_next_run")
  @@index([user_id], map: "idx_recurring_user_id")
}

model savings_contributions {
  id                String        @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  goal_id           String        @db.VarChar(36)
  account_id        String?       @db.VarChar(36)
  amount            Decimal       @db.Decimal(18, 2)
  contribution_date DateTime      @default(dbgenerated("(curdate())")) @db.Date
  note              String?       @db.Text
  created_at        DateTime      @default(now()) @db.DateTime(0)
  accounts          accounts?     @relation(fields: [account_id], references: [id], onUpdate: NoAction, map: "fk_savings_contributions_acc")
  savings_goals     savings_goals @relation(fields: [goal_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_savings_contributions_goal")

  @@index([account_id], map: "fk_savings_contributions_acc")
  @@index([goal_id], map: "idx_savings_contributions_goal_id")
}

model savings_goals {
  id                    String                  @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  user_id               String                  @db.VarChar(36)
  name                  String                  @db.VarChar(255)
  description           String?                 @db.Text
  target_amount         Decimal                 @db.Decimal(18, 2)
  target_date           DateTime?               @db.Date
  icon                  String?                 @db.VarChar(100)
  color                 String?                 @db.VarChar(50)
  is_completed          Boolean                 @default(false)
  created_at            DateTime                @default(now()) @db.DateTime(0)
  updated_at            DateTime                @updatedAt @db.DateTime(0)
  savings_contributions savings_contributions[]
  users                 User                    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_savings_goals_user")

  @@index([user_id], map: "idx_savings_goals_user_id")
}

model transactions {
  id                                                    String              @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  user_id                                               String              @db.VarChar(36)
  account_id                                            String              @db.VarChar(36)
  category_id                                           String?             @db.VarChar(36)
  type                                                  transactions_type
  status                                                transactions_status @default(completed)
  amount                                                Decimal             @db.Decimal(18, 2)
  transaction_date                                      DateTime            @default(dbgenerated("(curdate())")) @db.Date
  description                                           String?             @db.Text
  merchant                                              String?             @db.VarChar(255)
  reference_number                                      String?             @db.VarChar(255)
  expense_payment_id                                    String?             @unique(map: "expense_payment_id") @db.VarChar(36)
  settlement_id                                         String?             @unique(map: "settlement_id") @db.VarChar(36)
  created_at                                            DateTime            @default(now()) @db.DateTime(0)
  updated_at                                            DateTime            @updatedAt @db.DateTime(0)
  accounts                                              accounts            @relation(fields: [account_id], references: [id], onUpdate: NoAction, map: "fk_transactions_account")
  categories                                            categories?         @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "fk_transactions_category")
  expense_payments                                      expense_payments?   @relation(fields: [expense_payment_id], references: [id], onUpdate: NoAction, map: "fk_transactions_exp_payment")
  settlements                                           settlements?        @relation(fields: [settlement_id], references: [id], onUpdate: NoAction, map: "fk_transactions_settlement")
  users                                                 User                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transactions_user")
  transfers_transfers_from_transaction_idTotransactions transfers[]         @relation("transfers_from_transaction_idTotransactions")
  transfers_transfers_to_transaction_idTotransactions   transfers[]         @relation("transfers_to_transaction_idTotransactions")

  @@index([account_id], map: "fk_transactions_account")
  @@index([category_id], map: "fk_transactions_category")
  @@index([user_id, account_id], map: "idx_transactions_user_account")
  @@index([user_id, transaction_date], map: "idx_transactions_user_date")
  @@index([user_id, type], map: "idx_transactions_user_type")
}

model transfers {
  id                                                       String        @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  user_id                                                  String        @db.VarChar(36)
  from_account_id                                          String        @db.VarChar(36)
  to_account_id                                            String        @db.VarChar(36)
  amount                                                   Decimal       @db.Decimal(18, 2)
  transfer_date                                            DateTime      @default(dbgenerated("(curdate())")) @db.Date
  note                                                     String?       @db.Text
  from_transaction_id                                      String?       @db.VarChar(36)
  to_transaction_id                                        String?       @db.VarChar(36)
  created_at                                               DateTime      @default(now()) @db.DateTime(0)
  accounts_transfers_from_account_idToaccounts             accounts      @relation("transfers_from_account_idToaccounts", fields: [from_account_id], references: [id], onUpdate: NoAction, map: "fk_transfers_from_acc")
  transactions_transfers_from_transaction_idTotransactions transactions? @relation("transfers_from_transaction_idTotransactions", fields: [from_transaction_id], references: [id], onUpdate: NoAction, map: "fk_transfers_from_tx")
  accounts_transfers_to_account_idToaccounts               accounts      @relation("transfers_to_account_idToaccounts", fields: [to_account_id], references: [id], onUpdate: NoAction, map: "fk_transfers_to_acc")
  transactions_transfers_to_transaction_idTotransactions   transactions? @relation("transfers_to_transaction_idTotransactions", fields: [to_transaction_id], references: [id], onUpdate: NoAction, map: "fk_transfers_to_tx")
  users                                                    User          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transfers_user")

  @@index([from_account_id], map: "fk_transfers_from_acc")
  @@index([from_transaction_id], map: "fk_transfers_from_tx")
  @@index([to_account_id], map: "fk_transfers_to_acc")
  @@index([to_transaction_id], map: "fk_transfers_to_tx")
  @@index([user_id, transfer_date], map: "idx_transfers_date")
  @@index([user_id], map: "idx_transfers_user_id")
}

