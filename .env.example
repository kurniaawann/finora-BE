# Salin menjadi .env lalu isi nilainya. Jangan commit file .env.
# Hanya nilai yang berbeda per environment atau bersifat rahasia yang ada di sini;
# aturan bisnis (batas upload, pagination, rate limit) ada di kode.

NODE_ENV=development
PORT=5000

# URL publik server, dipakai untuk membentuk URL foto absolut ke aplikasi mobile.
# Produksi: https://api.domainkamu.com
APP_URL=http://localhost:5000

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/db_finora

# Minimal 32 karakter acak, berbeda untuk access & refresh. Contoh generate:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Folder penyimpanan foto (relatif ke root project atau path absolut).
# Produksi: arahkan ke volume persisten.
UPLOAD_DIR=uploads

# Opsional. Origin web yang boleh mengakses API, dipisah koma.
# Aplikasi mobile tidak membutuhkan CORS, biarkan kosong bila tidak ada klien web.
CORS_ORIGINS=

# Jumlah reverse proxy di depan server (mis. 1 bila di belakang Nginx/Load Balancer).
TRUST_PROXY=0

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Push notification (Firebase Cloud Messaging) — opsional.
# Ambil dari Firebase Console → Project settings → Service accounts →
# "Generate new private key" (file JSON). BUKAN config web (apiKey dll).
# Kosongkan untuk mematikan push; notifikasi in-app tetap berjalan.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Tulis dalam satu baris dengan \n, diapit tanda kutip ganda.
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Email (kode OTP verifikasi email & reset password) via SMTP — opsional.
# Contoh: Gmail (smtp.gmail.com:587 + App Password), Brevo, Resend, Mailgun.
# Kosongkan di development: isi email (termasuk kode OTP) dicetak ke log.
SMTP_HOST=
SMTP_PORT=587
# true untuk port 465 (SSL), false untuk 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Finora <no-reply@finora.app>"
